{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "pnpm build && pnpm --dir ../server build && electron .",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "package:mac:x64": "node ../scripts/prepare-prisma-runtime.mjs && pnpm build && electron-builder --mac dmg --x64 --publish never"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.motorcyclesystem.desktop",
    "productName": "Motorcycle System POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../resources/postgres-binaries", "to": "postgres-binaries" },
      { "from": "../server/dist", "to": "server/dist" },
      { "from": "../server/node_modules", "to": "server/node_modules" },
      { "from": "../prisma", "to": "prisma" },
      { "from": "../.build/prisma-cli", "to": "prisma-cli" },
      { "from": "../node_modules/@prisma/engines", "to": "prisma-cli/node_modules/@prisma/engines" }
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64"] }],
      "category": "public.app-category.business"
    },
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
