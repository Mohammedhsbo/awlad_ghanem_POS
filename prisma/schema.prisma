  email
  sms
  whatsapp
  push
}

enum NotificationStatus {
  pending
  sent
  delivered
  failed
  read
}

enum NotificationPriority {
  low
  normal
  high
  urgent
}

enum NotificationType {
  order_confirmed
  order_completed
  payment_received
  payment_reminder
  installment_due
  installment_overdue
  reservation_expiring
  reservation_expired
  letter_issued
