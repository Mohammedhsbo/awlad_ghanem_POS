  documentType      String               @db.VarChar(50)
  branchId          String?              @db.Uuid
  prefix            String?              @db.VarChar(10)
  includeBranchCode Boolean              @default(true)
  includeYear       Boolean              @default(true)
  sequenceLength    Int                  @default(4)
  currentSequence   Int                  @default(0)
  resetPolicy       NumberingResetPolicy @default(yearly)
  lastResetDate     DateTime?            @db.Date
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  branch Branch? @relation("DocumentNumberingBranch", fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([documentType, branchId])
  @@index([documentType])
  @@index([branchId])
  @@index([isActive])
  @@index([documentType, branchId, isActive])
}

model WorkingHours {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String    @db.Uuid
  dayOfWeek     Int
  openTime      DateTime?
  closeTime     DateTime?
  isClosed      Boolean   @default(false)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  branch Branch @relation("BranchWorkingHours", fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek, effectiveFrom])
  @@index([branchId])
  @@index([dayOfWeek])
  @@index([isActive])
  @@index([effectiveFrom, effectiveTo])
}

model Holiday {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  holidayName       String       @db.VarChar(200)
  holidayDate       DateTime     @db.Date
  scope             HolidayScope
  branchId          String?      @db.Uuid
  isRecurring       Boolean      @default(false)
  recurrencePattern String?      @db.VarChar(50)
  isActive          Boolean      @default(true)
  createdBy         String       @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  creator User    @relation("HolidayCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  branch  Branch? @relation("BranchHolidays", fields: [branchId], references: [id], onDelete: Cascade)

  @@index([holidayDate])
  @@index([scope])
  @@index([branchId])
  @@index([isActive])
  @@index([scope, branchId, holidayDate])
}

// SPEC-014: Integration & API Management

model ExternalProvider {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerKey      String           @unique @db.VarChar(100)
  providerName     String           @db.VarChar(200)
  category         ProviderCategory
  isEnabled        Boolean          @default(true)
  supportsWebhooks Boolean          @default(false)
  healthEndpoint   String?          @db.Text
  documentationUrl String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  integrations Integration[]

  @@index([providerKey])
  @@index([category])
  @@index([isEnabled])
}

model Integration {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId          String       @db.Uuid
  integrationName     String       @db.VarChar(200)
  branchId            String?      @db.Uuid
  isEnabled           Boolean      @default(false)
  configuration       Json
  encryptedSecrets    String?      @db.Text
  environment         String       @default("production") @db.VarChar(20)
  healthStatus        HealthStatus @default(unknown)
  lastHealthCheck     DateTime?
  lastError           String?      @db.Text
  consecutiveFailures Int          @default(0)
  createdBy           String       @db.Uuid
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  provider         ExternalProvider   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  creator          User               @relation("IntegrationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  branch           Branch?            @relation("BranchIntegrations", fields: [branchId], references: [id], onDelete: Cascade)
  webhookEndpoints WebhookEndpoint[]
  logs             IntegrationLog[]
  audits           IntegrationAudit[]

  @@index([providerId])
  @@index([branchId])
  @@index([isEnabled])
  @@index([healthStatus])
  @@index([environment])
}

model APIKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyPrefix   String    @unique @db.VarChar(20)
  keyHash     String    @unique @db.VarChar(128)
  description String?   @db.VarChar(500)
  scope       Json
  branchId    String?   @db.Uuid
  environment String    @default("production") @db.VarChar(20)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int       @default(0)
  isActive    Boolean   @default(true)
  createdBy   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator User    @relation("APIKeyCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  branch  Branch? @relation("BranchAPIKeys", fields: [branchId], references: [id], onDelete: Cascade)

  @@index([keyPrefix])
  @@index([keyHash])
  @@index([branchId])
  @@index([isActive])
  @@index([expiresAt])
}

model WebhookEndpoint {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integrationId String   @db.Uuid
  url           String   @db.Text
  events        Json
  secret        String   @db.VarChar(128)
  isEnabled     Boolean  @default(true)
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration               @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  creator     User                      @relation("WebhookCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  events_log  IntegrationWebhookEvent[]

  @@index([integrationId])
  @@index([isEnabled])
}

model IntegrationWebhookEvent {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId     String             @db.Uuid
  eventId        String             @unique @db.VarChar(200)
  eventType      String             @db.VarChar(100)
  payload        Json
  signature      String?            @db.Text
  receivedAt     DateTime           @default(now())
  processedAt    DateTime?
  attempts       Int                @default(0)
  lastAttemptAt  DateTime?
  status         WebhookEventStatus @default(pending)
  error          String?            @db.Text
  responseStatus Int?
  responseBody   String?            @db.Text

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([eventId])
  @@index([eventType])
  @@index([status])
  @@index([receivedAt])
  @@index([processedAt])
}

model IntegrationLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integrationId     String   @db.Uuid
  correlationId     String   @db.VarChar(100)
  operation         String   @db.VarChar(100)
  direction         String   @db.VarChar(20)
  requestUrl        String?  @db.Text
  requestMethod     String?  @db.VarChar(20)
  requestHeaders    Json?
  requestBody       String?  @db.Text
  responseStatus    Int?
  responseHeaders   Json?
  responseBody      String?  @db.Text
  duration          Int?
  errorCode         String?  @db.VarChar(100)
  errorMessage      String?  @db.Text
  retryAttempt      Int      @default(0)
  providerRequestId String?  @db.VarChar(200)
  createdAt         DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([correlationId])
  @@index([operation])
  @@index([createdAt])
  @@index([responseStatus])
}

model IntegrationAudit {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integrationId String   @db.Uuid
  action        String   @db.VarChar(100)
  previousValue Json?
  newValue      Json?
  changedBy     String   @db.Uuid
  changeReason  String?  @db.Text
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.Text
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  changer     User        @relation("IntegrationAuditChanger", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([integrationId])
  @@index([changedBy])
  @@index([createdAt])
}

model IdempotencyKey {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey  String   @unique @db.VarChar(200)
  scope           String   @db.VarChar(100)
  requestHash     String   @db.VarChar(128)
  responseStatus  Int
  responseHeaders Json?
  responseBody    String?  @db.Text
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([idempotencyKey])
  @@index([scope])
  @@index([expiresAt])
}

enum ProviderCategory {
  payment
  email
  sms
  whatsapp
  storage
  analytics
  other
}

enum HealthStatus {
  healthy
  degraded
  unhealthy
  unknown
}

enum WebhookEventStatus {
  pending
  processing
  succeeded
  failed
  dead_letter
}

enum InquiryDocumentType {
  PENSION
  COMMERCIAL_REGISTRY
  EMPLOYEE
  NEITHER
}

model Inquiry {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerName  String @db.VarChar(200)
  customerPhone String @db.VarChar(50)
  address       String? @db.Text
  occupation    String? @db.VarChar(200)

  documentType     InquiryDocumentType
  documentImage    String?
  idCardFrontImage String?
  idCardBackImage  String?

  guarantorIdFrontImage   String?
  guarantorIdBackImage    String?
  guarantorSignatureImage String?

  downPayment  Decimal?    @db.Decimal(10, 2)
  motorcycleId String?     @db.Uuid
  motorcycle   Motorcycle? @relation(fields: [motorcycleId], references: [id])
  financingCompanyId String? @db.Uuid
  financingCompany   FinancingCompany? @relation(fields: [financingCompanyId], references: [id])
  installmentDurationId String? @db.Uuid
  installmentDuration   InstallmentDuration? @relation(fields: [installmentDurationId], references: [id])

  createdBy String? @db.Uuid
  user      User?   @relation(fields: [createdBy], references: [id])

  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  installmentRequest InstallmentRequest?
}

enum SalePaymentMethod {
  CASH
  VISA
}

model Sale {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  motorcycleId String     @db.Uuid
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id])

  customerName    String  @db.VarChar(200)
  customerPhone   String  @db.VarChar(50)
  customerIdImage String?

  salePrice     Decimal           @db.Decimal(10, 2)
  paymentMethod SalePaymentMethod

  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdBy String? @db.Uuid
  user      User?   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SaleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model SaleRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerName  String @db.VarChar(200)
  customerPhone String @db.VarChar(50)

  motorcycleId String     @db.Uuid
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id])

  financingCompanyId String           @db.Uuid
  financingCompany   FinancingCompany @relation(fields: [financingCompanyId], references: [id])

  requestedAmount Decimal           @db.Decimal(10, 2)
  status          SaleRequestStatus @default(PENDING)

  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdBy String? @db.Uuid
  user      User?   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installmentPlan PosInstallmentPlan?
}

enum PosReservationStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

model PosReservation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerName  String @db.VarChar(200)
  customerPhone String @db.VarChar(50)

  motorcycleId String     @db.Uuid
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id])

  holdAmount      Decimal              @db.Decimal(10, 2)
  reservationDate DateTime             @default(now())
  status          PosReservationStatus @default(ACTIVE)

  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdBy String? @db.Uuid
  user      User?   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PosInstallmentPlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
}

model PosInstallmentPlan {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  saleRequestId String?      @unique @db.Uuid
  saleRequest   SaleRequest? @relation(fields: [saleRequestId], references: [id])

  customerName  String @db.VarChar(200)
  customerPhone String @db.VarChar(50)

  motorcycleId String     @db.Uuid
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id])

  totalAmount      Decimal @db.Decimal(12, 2)
  paidAmount       Decimal @default(0) @db.Decimal(12, 2)
  remainingBalance Decimal @db.Decimal(12, 2)

  status PosInstallmentPlanStatus @default(ACTIVE)

  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdBy String? @db.Uuid
  user      User?   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments PosInstallment[]
}

enum PosInstallmentStatus {
  UNPAID
  PARTIAL
  PAID
}

model PosInstallment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  planId String             @db.Uuid
  plan   PosInstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  dueDate DateTime @db.Date

  amount     Decimal @db.Decimal(12, 2)
  paidAmount Decimal @default(0) @db.Decimal(12, 2)

  status PosInstallmentStatus @default(UNPAID)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Desktop-specific Permissions ──────────────────────────────────
// Desktop-only role and permission data.
model DesktopPermission {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user   User   @relation("DesktopPermissions", fields: [userId], references: [id], onDelete: Cascade)

  // Page/feature key (e.g. "sales", "inventory", "installments", "inquiries", etc.)
  pageKey String  @db.VarChar(80)
  canView Boolean @default(false)
  canEdit Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, pageKey])
  @@index([userId])
}

// ─── Desktop Attendance ─────────────────────────────────────────────
model DesktopAttendance {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user   User   @relation("DesktopAttendance", fields: [userId], references: [id], onDelete: Cascade)

  checkIn  DateTime
  checkOut DateTime?
  branchId String?   @db.Uuid
  branch   Branch?   @relation("DesktopAttendanceBranch", fields: [branchId], references: [id])
  notes    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([checkIn])
}
