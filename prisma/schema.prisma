generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows", "darwin"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr              String                @db.VarChar(200)
  nameEn              String                @db.VarChar(200)
  address             String?
  phone               String?               @db.VarChar(20)
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  users               User[]
  auditLogs           AuditLog[]
  motorcycles         Motorcycle[]
  purchases           Purchase[]
  transfersOut        Transfer[]            @relation("TransferFromBranch")
  transfersIn         Transfer[]            @relation("TransferToBranch")
  orders              Order[]
  desktopOrders       DesktopOrder[]
  reservations        Reservation[]
  desktopReservations DesktopReservation[]
  invoices            Invoice[]
  payments            Payment[]
  financingContracts  FinancingContract[]
  letters             Letter[]
  notifications       Notification[]
  configurations      BranchConfiguration[] @relation("BranchConfigurations")
  configAudits        ConfigurationAudit[]  @relation("ConfigAuditBranch")
  documentNumberings  DocumentNumbering[]   @relation("DocumentNumberingBranch")
  workingHours        WorkingHours[]        @relation("BranchWorkingHours")
  holidays            Holiday[]             @relation("BranchHolidays")
  integrations        Integration[]         @relation("BranchIntegrations")
  apiKeys             APIKey[]              @relation("BranchAPIKeys")
  Inquiry             Inquiry[]
  Sale                Sale[]
  SaleRequest         SaleRequest[]
  PosReservation      PosReservation[]
  PosInstallmentPlan  PosInstallmentPlan[]
  desktopAttendance   DesktopAttendance[]   @relation("DesktopAttendanceBranch")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId   String @db.Uuid
  resource String @db.VarChar(50)
  action   String @db.VarChar(20)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([roleId])
}

model User {
  id                         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String                   @db.VarChar(200)
  email                      String                   @unique @db.VarChar(255)
  passwordHash               String                   @db.VarChar(255)
  phone                      String?                  @db.VarChar(20)
  whatsappSenderNumber       String?                  @unique @db.VarChar(20)
  branchId                   String?                  @db.Uuid
  roleId                     String                   @db.Uuid
  lang                       String                   @default("ar") @db.VarChar(2)
  isActive                   Boolean                  @default(true)
  lastLoginAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  branch                     Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role                       Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs                  AuditLog[]
  purchases                  Purchase[]
  transfers                  Transfer[]
  orders                     Order[]
  desktopOrders              DesktopOrder[]
  reservations               Reservation[]
  desktopReservations        DesktopReservation[]
  invoices                   Invoice[]
  payments                   Payment[]
  refunds                    Refund[]
  createdFinancingContracts  FinancingContract[]      @relation("FinancingCreator")
  approvedFinancingContracts FinancingContract[]      @relation("FinancingApprover")
  createdLetters             Letter[]                 @relation("LetterCreator")
  confirmedLetters           Letter[]                 @relation("LetterConfirmer")
  createdLetterDocuments     LetterDocument[]         @relation("LetterDocumentCreator")
  createdCustomerInquiries   CustomerInquiry[]        @relation("CustomerInquiryCreator")
  letterHistoryActions       LetterHistory[]          @relation("LetterHistoryActor")
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  communicationLogs          CommunicationLog[]
  companyConfigsCreated      CompanyConfiguration[]   @relation("CompanyConfigCreator")
  branchConfigsCreated       BranchConfiguration[]    @relation("BranchConfigCreator")
  featureFlagsCreated        FeatureFlag[]            @relation("FeatureFlagCreator")
  configAuditsPerformed      ConfigurationAudit[]     @relation("ConfigAuditChanger")
  holidaysCreated            Holiday[]                @relation("HolidayCreator")
  integrationsCreated        Integration[]            @relation("IntegrationCreator")
  integrationAuditsPerformed IntegrationAudit[]       @relation("IntegrationAuditChanger")
  apiKeysCreated             APIKey[]                 @relation("APIKeyCreator")
  webhookEndpointsCreated    WebhookEndpoint[]        @relation("WebhookCreator")
  Inquiry                    Inquiry[]
  Sale                       Sale[]
  SaleRequest                SaleRequest[]
  PosReservation             PosReservation[]
  PosInstallmentPlan         PosInstallmentPlan[]
  desktopPermissions         DesktopPermission[]      @relation("DesktopPermissions")
  desktopAttendance          DesktopAttendance[]      @relation("DesktopAttendance")

  @@index([branchId])
  @@index([roleId])
}

enum MotorcycleStatus {
  in_transit
  available
  reserved
  sold
  in_transfer
  maintenance
  returned
}

enum PurchaseStatus {
  draft
  ordered
  partially_received
  received
  cancelled
}

enum TransferStatus {
  initiated
  in_transit
  received
  cancelled
}

enum OrderStatus {
  draft
  confirmed
  processing
  awaiting_delivery
  completed
  cancelled
  refunded
}

enum DesktopOrderPaymentType {
  CASH
  INSTALLMENT
}

enum MotorcycleCondition {
  NEW
  IMPORTED
}

model Brand {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr      String       @db.VarChar(200)
  nameEn      String       @db.VarChar(200)
  logo        String?      @db.VarChar(500)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  motorcycles Motorcycle[]

  @@unique([nameAr])
  @@unique([nameEn])
}

model Category {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr      String       @db.VarChar(200)
  nameEn      String       @db.VarChar(200)
  parentId    String?      @db.Uuid
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]   @relation("CategoryHierarchy")
  motorcycles Motorcycle[]

  @@unique([nameAr, parentId])
  @@unique([nameEn, parentId])
  @@index([parentId])
}

model Motorcycle {
  id                           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vin                          String               @unique @db.VarChar(50)
  engineNumber                 String?              @unique @db.VarChar(100)
  model                        String               @db.VarChar(200)
  year                         Int
  color                        String?              @db.VarChar(50)
  engineSize                   String?              @db.VarChar(20)
  descriptionAr                String?              @db.Text
  descriptionEn                String?              @db.Text
  price                        Decimal              @db.Decimal(12, 2)
  costPrice                    Decimal              @db.Decimal(12, 2)
  condition                    MotorcycleCondition  @default(NEW)
  reservationDepositAmount     Decimal?             @db.Decimal(12, 2)
  reservationDepositPercentage Decimal?             @db.Decimal(5, 2)
  status                       MotorcycleStatus     @default(available)
  images                       Json?                @default("[]")
  branchId                     String               @db.Uuid
  brandId                      String               @db.Uuid
  categoryId                   String               @db.Uuid
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  branch                       Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  brand                        Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category                     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purchaseItem                 PurchaseItem?
  transferItems                TransferItem[]
  orderItems                   OrderItem[]
  reservations                 Reservation[]
  invoiceItems                 InvoiceItem[]
  letters                      Letter[]
  installmentRequests          InstallmentRequest[]
  Inquiry                      Inquiry[]
  Sale                         Sale[]
  SaleRequest                  SaleRequest[]
  PosReservation               PosReservation[]
  PosInstallmentPlan           PosInstallmentPlan[]
  DesktopOrderItem             DesktopOrderItem[]
  DesktopReservation           DesktopReservation[]

  @@index([status])
  @@index([branchId])
  @@index([brandId])
  @@index([categoryId])
  @@index([year])
  @@index([price])
}

model AuditLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Exactly one of userId / customerId is set: staff act as User rows,
  // e-commerce customers as Customer rows, and the two id spaces are disjoint.
  userId     String?   @db.Uuid
  customerId String?   @db.Uuid
  action     String    @db.VarChar(50)
  entityType String    @db.VarChar(50)
  entityId   String    @db.Uuid
  branchId   String?   @db.Uuid
  before     Json?
  after      Json?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([customerId])
  @@index([createdAt])
  @@index([branchId])
}

model Supplier {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String     @unique @db.VarChar(200)
  contactPerson String?    @db.VarChar(200)
  phone         String?    @db.VarChar(20)
  email         String?
  address       String?
  notes         String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases     Purchase[]
}

model Purchase {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseNumber String         @unique @db.VarChar(50)
  supplierId     String         @db.Uuid
  branchId       String         @db.Uuid
  userId         String         @db.Uuid
  totalAmount    Decimal        @db.Decimal(12, 2)
  status         PurchaseStatus @default(draft)
  receivedAt     DateTime?
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    PurchaseItem[]

  @@index([supplierId])
  @@index([branchId])
  @@index([userId])
  @@index([status])
}

model PurchaseItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId   String   @db.Uuid
  motorcycleId String?  @unique @db.Uuid // Nullable until received. One-to-one mapping
  model        String   @db.VarChar(200)
  vin          String?  @db.VarChar(50)
  quantity     Int      @default(1)
  unitCost     Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  purchase   Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  motorcycle Motorcycle? @relation(fields: [motorcycleId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
}

model Transfer {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferNumber String         @unique @db.VarChar(50)
  fromBranchId   String         @db.Uuid
  toBranchId     String         @db.Uuid
  userId         String         @db.Uuid
  status         TransferStatus @default(initiated)
  notes          String?        @db.Text
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  fromBranch Branch         @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch         @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  items      TransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([userId])
  @@index([status])
}

model TransferItem {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferId   String @db.Uuid
  motorcycleId String @db.Uuid

  transfer   Transfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  motorcycle Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([motorcycleId])
}

model Customer {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @db.VarChar(200)
  phone               String               @unique @db.VarChar(20)
  email               String?              @unique @db.VarChar(255)
  passwordHash        String?              @db.VarChar(255)
  nationalId          String?              @unique @db.VarChar(20)
  address             String?              @db.Text
  notes               String?              @db.Text
  googleId            String?              @unique @db.VarChar(255)
  authProvider        String               @default("local") @db.VarChar(20)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  addresses           Address[]
  orders              Order[]
  reservations        Reservation[]
  desktopOrders       DesktopOrder[]
  desktopReservations DesktopReservation[]
  invoices            Invoice[]
  payments            Payment[]
  financingContracts  FinancingContract[]
  installmentRequests InstallmentRequest[]
  letters             Letter[]
  communicationLogs   CommunicationLog[]
  auditLogs           AuditLog[]
  inquiries           CustomerInquiry[]

  @@index([phone])
  @@index([email])
  @@index([nationalId])
  @@index([googleId])
  @@index([name, phone])
}

model Address {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @db.Uuid
  label       String   @default("Home") @db.VarChar(100)
  addressLine String   @db.Text
  city        String?  @db.VarChar(100)
  region      String?  @db.VarChar(100)
  postalCode  String?  @db.VarChar(20)
  country     String   @default("Saudi Arabia") @db.VarChar(100)
  isDefault   Boolean  @default(false)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, isDefault])
}

model CustomerInquiry {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId        String   @db.Uuid
  address           String   @db.Text
  phone             String   @db.VarChar(20)
  occupation        String   @db.VarChar(200)
  occupationAddress String   @db.Text
  idCardFrontImage  String   @db.VarChar(500)
  idCardBackImage   String   @db.VarChar(500)
  createdBy         String   @db.Uuid
  createdAt         DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator  User     @relation("CustomerInquiryCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([createdBy])
  @@index([createdAt])
}

model Order {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber String      @unique @db.VarChar(30)
  customerId  String      @db.Uuid
  branchId    String      @db.Uuid
  userId      String?     @db.Uuid
  status      OrderStatus @default(draft)
  totalAmount Decimal     @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  netAmount   Decimal     @db.Decimal(12, 2)
  address     String?     @db.Text
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user               User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  reservation        Reservation?
  invoice            Invoice?
  financingContracts FinancingContract[]
  letters            Letter[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String     @db.Uuid
  motorcycleId String     @db.Uuid
  unitPrice    Decimal    @db.Decimal(12, 2)
  discount     Decimal    @default(0) @db.Decimal(12, 2)
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)

  @@unique([orderId, motorcycleId])
  @@index([orderId])
  @@index([motorcycleId])
}

model DesktopOrder {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber    String                  @unique @db.VarChar(30)
  customerId     String                  @db.Uuid
  branchId       String                  @db.Uuid
  userId         String                  @db.Uuid
  status         OrderStatus             @default(confirmed)
  paymentType    DesktopOrderPaymentType
  totalAmount    Decimal                 @db.Decimal(12, 2)
  discount       Decimal                 @default(0) @db.Decimal(12, 2)
  netAmount      Decimal                 @db.Decimal(12, 2)
  customerIdImage String?                @db.VarChar(500)
  address        String?                 @db.Text
  notes          String?                 @db.Text
  idempotencyKey String                  @unique @db.VarChar(200)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  items       DesktopOrderItem[]
  reservation DesktopReservation?

  @@index([customerId])
  @@index([branchId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model DesktopOrderItem {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String       @db.Uuid
  motorcycleId String       @db.Uuid
  unitPrice    Decimal      @db.Decimal(12, 2)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  order        DesktopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  motorcycle   Motorcycle   @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)

  @@unique([orderId, motorcycleId])
  @@index([orderId])
  @@index([motorcycleId])
}

enum ReservationStatus {
  active
  converted
  expired
  cancelled
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overpaid
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  completed
  failed
  cancelled
  refunded
  partially_refunded
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  cheque
}

enum FinancingContractStatus {
  active
  completed
  defaulted
  cancelled
}

enum InstallmentStatus {
  upcoming
  due
  paid
  overdue
}

enum InstallmentFrequency {
  monthly
  quarterly
}

enum InstallmentRequestStatus {
  pending
  approved
  rejected
}

model FinancingCompany {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @db.VarChar(200)
  whatsappNumber      String               @db.VarChar(20)
  isActive            Boolean              @default(true)
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  installmentRequests InstallmentRequest[]
  inquiries           Inquiry[]
  SaleRequest         SaleRequest[]

  @@index([isActive, sortOrder])
}

model InstallmentDuration {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  months              Int
  isActive            Boolean              @default(true)
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  installmentRequests InstallmentRequest[]
  inquiries           Inquiry[]

  @@unique([months])
  @@index([isActive, sortOrder])
}

model Settings {
  id                       String   @id @default("default") @db.VarChar(50)
  instagramUrl             String?  @db.VarChar(500)
  contactPhone             String?  @db.VarChar(20)
  defaultDepositAmount     Decimal? @db.Decimal(12, 2)
  defaultDepositPercentage Decimal? @db.Decimal(5, 2)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model InstallmentRequest {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId                String?                  @unique @db.Uuid
  customerId               String                   @db.Uuid
  motorcycleId             String                   @db.Uuid
  financingCompanyId       String                   @db.Uuid
  installmentDurationId    String                   @db.Uuid
  status                   InstallmentRequestStatus @default(pending)
  buyerName                String                   @db.VarChar(200)
  buyerPhone               String                   @db.VarChar(20)
  buyerEmail               String?                  @db.VarChar(255)
  buyerAddress             String?                  @db.Text
  buyerOccupation          String?                  @db.VarChar(200)
  buyerNationalIdImage     String                   @db.VarChar(500)
  buyerNationalIdBackImage String?                  @db.VarChar(500)
  salarySlipImage          String?                  @db.VarChar(500)
  apartmentContractImage   String?                  @db.VarChar(500)
  guarantorName            String?                  @db.VarChar(200)
  guarantorPhone           String?                  @db.VarChar(20)
  guarantorAddress         String?                  @db.Text
  guarantorNationalIdImage String?                  @db.VarChar(500)
  guarantorNationalIdBackImage String?              @db.VarChar(500)
  guarantorSignatureImage  String?                  @db.VarChar(500)
  motorcyclePrice          Decimal                  @db.Decimal(12, 2)
  downPayment              Decimal                  @db.Decimal(12, 2)
  monthlyInstallment       Decimal                  @db.Decimal(12, 2)
  rejectionReason          String?                  @db.Text
  reviewedAt               DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  motorcycle       Motorcycle          @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  financingCompany FinancingCompany    @relation(fields: [financingCompanyId], references: [id], onDelete: Restrict)
  duration         InstallmentDuration @relation(fields: [installmentDurationId], references: [id], onDelete: Restrict)
  inquiry          Inquiry?            @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([motorcycleId])
  @@index([financingCompanyId])
  @@index([installmentDurationId])
  @@index([status])
  @@index([createdAt])
}

model Reservation {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationNumber String            @unique @db.VarChar(30)
  customerId        String            @db.Uuid
  motorcycleId      String            @db.Uuid
  branchId          String            @db.Uuid
  userId            String?           @db.Uuid
  status            ReservationStatus @default(active)
  totalPrice        Decimal           @db.Decimal(12, 2)
  paidAmount        Decimal           @default(0) @db.Decimal(12, 2)
  remainingAmount   Decimal           @db.Decimal(12, 2)
  penaltyAmount     Decimal           @default(0) @db.Decimal(12, 2)
  address           String?           @db.Text
  expiresAt         DateTime?
  notes             String?           @db.Text
  convertedOrderId  String?           @unique @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  motorcycle     Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  branch         Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  convertedOrder Order?     @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)
  invoice        Invoice?
  letters        Letter[]

  @@index([reservationNumber])
  @@index([customerId])
  @@index([motorcycleId])
  @@index([status])
  @@index([expiresAt])
  @@index([branchId])
  @@index([status, expiresAt])
}

model DesktopReservation {
