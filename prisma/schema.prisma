  targetBranches    Json?
  rolloutPercentage Int              @default(0)
  environment       String           @default("production") @db.VarChar(20)
  createdBy         String           @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  creator User @relation("FeatureFlagCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([flagKey])
  @@index([isEnabled])
  @@index([scope])
  @@index([environment])
}

model ConfigurationAudit {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configType      String   @db.VarChar(50)
  configKey       String   @db.VarChar(100)
  branchId        String?  @db.Uuid
  previousValue   String?  @db.Text
  newValue        String   @db.Text
  changeReason    String?  @db.Text
  changedBy       String   @db.Uuid
  changeTimestamp DateTime @default(now())
  ipAddress       String?  @db.VarChar(45)
  userAgent       String?  @db.Text

  changer User    @relation("ConfigAuditChanger", fields: [changedBy], references: [id], onDelete: Restrict)
  branch  Branch? @relation("ConfigAuditBranch", fields: [branchId], references: [id], onDelete: SetNull)

  @@index([configType])
  @@index([configKey])
  @@index([branchId])
  @@index([changedBy])
  @@index([changeTimestamp])
  @@index([configKey, changeTimestamp])
}

model DocumentNumbering {
