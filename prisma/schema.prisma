  unitPrice    Decimal  @db.Decimal(12, 2)
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice   Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  invoice    Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  motorcycle Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([motorcycleId])
}

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentReference      String        @unique @db.VarChar(50)
  invoiceId             String?       @db.Uuid
  customerId            String        @db.Uuid
  branchId              String        @db.Uuid
  userId                String        @db.Uuid
  amount                Decimal       @db.Decimal(12, 2)
  method                PaymentMethod
  status                PaymentStatus @default(pending)
  reference             String?       @db.VarChar(200)
  externalTransactionId String?       @db.VarChar(200)
  providerId            String?       @db.VarChar(100)
  idempotencyKey        String        @unique @db.VarChar(200)
  cashAmountReceived    Decimal?      @db.Decimal(12, 2)
  cashChange            Decimal?      @db.Decimal(12, 2)
  confirmedAt           DateTime?
  failedAt              DateTime?
  failureReason         String?       @db.Text
  notes                 String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  invoice     Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  refunds     Refund[]

  @@index([paymentReference])
  @@index([invoiceId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([method])
  @@index([idempotencyKey])
  @@index([externalTransactionId])
  @@index([createdAt])
  @@index([status, branchId])
}

model PaymentAllocation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId     String   @db.Uuid
  invoiceId     String?  @db.Uuid
  installmentId String?  @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([invoiceId])
  @@index([installmentId])
}

model Refund {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refundReference String        @unique @db.VarChar(50)
  paymentId       String        @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  reason          String        @db.Text
  method          PaymentMethod
  status          String        @default("pending") @db.VarChar(20)
  processedBy     String        @db.Uuid
  processedAt     DateTime?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  processedByUser User    @relation(fields: [processedBy], references: [id], onDelete: Restrict)

  @@index([refundReference])
  @@index([paymentId])
  @@index([processedBy])
  @@index([createdAt])
  @@index([status])
}

model WebhookEvent {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId            String   @db.VarChar(50)
  eventId               String   @db.VarChar(200)
  eventType             String   @db.VarChar(100)
  providerTransactionId String   @db.VarChar(200)
  paymentId             String?  @db.Uuid
  status                String   @db.VarChar(50)
  result                String   @db.VarChar(50)
  rawPayload            Json
  createdAt             DateTime @default(now())

  @@unique([providerId, eventId])
  @@index([providerId])
  @@index([eventId])
  @@index([providerTransactionId])
  @@index([paymentId])
  @@index([createdAt])
}

model FinancingContract {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractNumber       String                  @unique @db.VarChar(50)
  customerId           String                  @db.Uuid
  orderId              String                  @db.Uuid
  branchId             String                  @db.Uuid
  createdBy            String                  @db.Uuid
  approvedBy           String?                 @db.Uuid
  totalAmount          Decimal                 @db.Decimal(12, 2)
  downPayment          Decimal                 @default(0) @db.Decimal(12, 2)
  financingAmount      Decimal                 @db.Decimal(12, 2)
  numberOfInstallments Int
  installmentFrequency InstallmentFrequency    @default(monthly)
  interestRate         Decimal                 @default(0) @db.Decimal(5, 2)
  startDate            DateTime                @db.Date
  status               FinancingContractStatus @default(active)
  approvedAt           DateTime?
  completedAt          DateTime?
  notes                String?                 @db.Text
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creator      User          @relation("FinancingCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver     User?         @relation("FinancingApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  installments Installment[]

  @@index([contractNumber])
  @@index([customerId])
  @@index([orderId])
  @@index([branchId])
  @@index([status])
  @@index([createdBy])
  @@index([approvedBy])
  @@index([startDate])
  @@index([status, branchId])
