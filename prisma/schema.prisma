model Letter {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  letterNumber         String       @unique @db.VarChar(30)
  customerId           String       @db.Uuid
  motorcycleId         String       @db.Uuid
  orderId              String?      @db.Uuid
  reservationId        String?      @db.Uuid
  branchId             String       @db.Uuid
  type                 LetterType   @default(receipt)
  status               LetterStatus @default(issued)
  issuedAt             DateTime     @default(now())
  confirmedAt          DateTime?
  expectedDeliveryDate DateTime?    @db.Date
  documentStorageRef   String?      @db.VarChar(255)
  userId               String       @db.Uuid
  confirmedBy          String?      @db.Uuid
  notes                String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  motorcycle  Motorcycle       @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reservation Reservation?     @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creator     User             @relation("LetterCreator", fields: [userId], references: [id], onDelete: Restrict)
  confirmer   User?            @relation("LetterConfirmer", fields: [confirmedBy], references: [id], onDelete: Restrict)
  documents   LetterDocument[]
  history     LetterHistory[]

  @@index([letterNumber])
  @@index([customerId])
  @@index([motorcycleId])
  @@index([orderId])
  @@index([reservationId])
  @@index([branchId])
  @@index([status])
  @@index([type])
  @@index([issuedAt])
  @@index([userId])
  @@index([confirmedBy])
  @@index([status, branchId])
  @@index([status, issuedAt])
}

model LetterDocument {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  letterId     String   @db.Uuid
  documentType String   @db.VarChar(50)
  fileName     String   @db.VarChar(255)
  fileSize     Int
  mimeType     String   @db.VarChar(100)
  storageRef   String   @db.VarChar(500)
  version      Int      @default(1)
  createdBy    String   @db.Uuid
  createdAt    DateTime @default(now())

  letter  Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  creator User   @relation("LetterDocumentCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([letterId])
  @@index([documentType])
  @@index([createdAt])
  @@index([letterId, version])
}

model LetterHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  letterId   String   @db.Uuid
  action     String   @db.VarChar(50)
  fromStatus String?  @db.VarChar(20)
  toStatus   String?  @db.VarChar(20)
  actorId    String   @db.Uuid
  reason     String?  @db.VarChar(500)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  actor  User   @relation("LetterHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([letterId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([letterId, createdAt])
}

// SPEC-012: Notifications & Communication

model Notification {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String               @db.Uuid
  branchId     String?              @db.Uuid
  type         NotificationType
  channel      NotificationChannel
  priority     NotificationPriority @default(normal)
  title        String               @db.VarChar(200)
  titleAr      String?              @db.VarChar(200)
  message      String               @db.Text
  messageAr    String?              @db.Text
  data         Json?
  status       NotificationStatus   @default(pending)
  readAt       DateTime?
  sentAt       DateTime?
  scheduledFor DateTime?
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([userId, status])
  @@index([userId, readAt])
  @@index([branchId])
  @@index([type])
  @@index([status])
  @@index([scheduledFor])
  @@index([createdAt])
}

model NotificationTemplate {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String              @unique @db.VarChar(100)
  type      NotificationType
  channel   NotificationChannel
  titleEn   String              @db.VarChar(200)
  titleAr   String              @db.VarChar(200)
  bodyEn    String              @db.Text
  bodyAr    String              @db.Text
  variables Json?               @default("[]")
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([code])
  @@index([type])
  @@index([channel])
}

model NotificationPreference {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @db.Uuid
  type      NotificationType
  channel   NotificationChannel
  isEnabled Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@index([userId])
}

model NotificationDelivery {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String              @db.Uuid
  channel        NotificationChannel
  recipient      String              @db.VarChar(255)
  status         NotificationStatus  @default(pending)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  sentAt         DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  errorMessage   String?             @db.Text
  externalId     String?             @db.VarChar(255)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
  @@index([channel])
  @@index([sentAt])
}

model CommunicationLog {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?             @db.Uuid
  customerId String?             @db.Uuid
  channel    NotificationChannel
  direction  String              @db.VarChar(20) // inbound, outbound
  subject    String?             @db.VarChar(200)
  content    String              @db.Text
  metadata   Json?
  sentAt     DateTime            @default(now())
  createdAt  DateTime            @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerId])
  @@index([channel])
  @@index([sentAt])
}

model Outbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateId   String    @db.Uuid
  aggregateType String    @db.VarChar(100)
  eventType     String    @db.VarChar(100)
  payload       Json
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([processedAt])
  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
}

// SPEC-013: System Administration & Configuration

enum ConfigDataType {
  string
  number
  boolean
  json
  date
}

enum ConfigScope {
  system
  company
  branch
  user
}

enum FeatureFlagScope {
  system
  branch
  user
}

enum NumberingResetPolicy {
  never
  yearly
  monthly
}

enum HolidayScope {
  system
  branch
}

model SystemConfiguration {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey       String         @unique @db.VarChar(100)
  configValue     String         @db.Text
  dataType        ConfigDataType
  category        String         @db.VarChar(50)
  description     String?        @db.Text
  isRequired      Boolean        @default(false)
  defaultValue    String?        @db.Text
  validationRules Json?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([configKey, isActive])
}

model CompanyConfiguration {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey        String         @db.VarChar(100)
  configValue      String         @db.Text
  dataType         ConfigDataType
  effectiveFrom    DateTime?      @db.Date
  effectiveTo      DateTime?      @db.Date
  version          Int            @default(1)
  replacesConfigId String?        @db.Uuid
  isActive         Boolean        @default(true)
  createdBy        String         @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  creator User @relation("CompanyConfigCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([configKey])
  @@index([isActive])
  @@index([effectiveFrom, effectiveTo])
  @@index([configKey, isActive])
}

model BranchConfiguration {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId            String         @db.Uuid
  configKey           String         @db.VarChar(100)
  configValue         String         @db.Text
  dataType            ConfigDataType
  inheritsFromCompany Boolean        @default(true)
  isActive            Boolean        @default(true)
  createdBy           String         @db.Uuid
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  branch  Branch @relation("BranchConfigurations", fields: [branchId], references: [id], onDelete: Cascade)
  creator User   @relation("BranchConfigCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([branchId, configKey])
  @@index([branchId])
  @@index([configKey])
  @@index([isActive])
  @@index([branchId, configKey, isActive])
}

model FeatureFlag {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flagKey           String           @unique @db.VarChar(100)
  flagName          String           @db.VarChar(200)
  description       String?          @db.Text
  isEnabled         Boolean          @default(false)
